# Adzuna developer account: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed developer account: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Gemini API key: https://aistudio.google.com/apikey
# Optional -- without it the pipeline still runs, but application-tracker
# rows get no LLM analysis (CV match/gap, pass %, worth applying, CV pick,
# edit notes), and the Streamlit tracker's manual-add feature (paste a URL
# or JD text) can't run. Verify the current model name in your Gemini
# console and override GEMINI_MODEL below if it differs from the default.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Per-run spend logging (printed to stdout, and logged in
# data/applications.json's llm_spend_log) estimates cost from token counts
# using these placeholder prices (USD per 1M tokens) -- NOT verified
# against current Gemini billing. Check your Gemini console for the real
# rate for GEMINI_MODEL and override here if it differs.
# GEMINI_INPUT_PRICE_PER_MTOK=0.30
# GEMINI_OUTPUT_PRICE_PER_MTOK=2.50

# Only needed for the Streamlit tracker's GitHub write-back when deployed
# somewhere with an ephemeral filesystem (e.g. Streamlit Community Cloud).
# Not needed to run the pipeline or the tracker locally. See app/README.md.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo
