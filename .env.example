# Adzuna developer account: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed developer account: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Gemini API key: https://aistudio.google.com/apikey
# Optional -- without it the pipeline still runs, but application-tracker
# rows get no LLM analysis (CV match/gap, pass %, worth applying, CV pick,
# edit notes). Verify the current model name in your Gemini console and
# override GEMINI_MODEL below if it differs from the code's default.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Only needed for the Streamlit tracker's GitHub write-back when deployed
# somewhere with an ephemeral filesystem (e.g. Streamlit Community Cloud).
# Not needed to run the pipeline or the tracker locally. See app/README.md.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo
